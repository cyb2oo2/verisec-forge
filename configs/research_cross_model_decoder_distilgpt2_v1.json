{
  "name": "cross_model_decoder_distilgpt2_v1",
  "model_name": "distilgpt2",
  "train_dataset": "data/processed/secure_code_primevul_joint_side_choice_train_v1.jsonl",
  "eval_dataset": "data/processed/secure_code_primevul_joint_side_choice_eval_v1.jsonl",
  "output_dir": "checkpoints/cls_secure_code_cross_model_distilgpt2_lora_v1",
  "report_output": "reports/secure_code_cross_model_distilgpt2_lora_v1_train_report.json",
  "seed": 42,
  "max_seq_length": 1024,
  "peft": {
    "r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "target_modules": [
      "c_attn",
      "c_proj",
      "c_fc"
    ]
  },
  "training": {
    "num_train_epochs": 1,
    "learning_rate": 0.0001,
    "per_device_train_batch_size": 4,
    "per_device_eval_batch_size": 8,
    "gradient_accumulation_steps": 4,
    "logging_steps": 25
  },
  "claim_boundary": "Non-Qwen decoder classifier replication slot for PR #12; this is not a new readout ablation, router, calibration, or side-order architecture."
}
